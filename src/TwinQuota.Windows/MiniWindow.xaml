<Window x:Class="TwinQuota.Windows.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TwinQuota Mini"
        Icon="Assets/TwinQuota.ico"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="Transparent"
        BorderThickness="0"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Window.Resources>
        <Style x:Key="MiniProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="#232B3F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniRoundButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1C2333" />
            <Setter Property="BorderBrush" Value="#2D374D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#273248" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#3E4C69" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="#000000" />
        </Grid.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid x:Name="CardHost">
                <Border x:Name="MainCard"
                        Background="#111624"
                        BorderBrush="#232D48"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="14,10"
                        Width="246">
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding MiniScale}" ScaleY="{Binding MiniScale}" />
                    </Border.LayoutTransform>
                    <StackPanel>
                    <!-- Top Row: Model Name & Info (Reset time + Context usage) -->
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ModelName}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="#D5DCEB"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ModelName}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResetTimeText}"
                                       FontSize="11"
                                       Foreground="#8A96AE"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ResetTimeVisibility}" />

                            <Border x:Name="ContextContainer"
                                    Background="Transparent"
                                    ToolTipService.InitialShowDelay="50"
                                    ToolTipService.ShowDuration="10000"
                                    Visibility="{Binding ContextVisibility}">
                                <Border.ToolTip>
                                    <ToolTip Background="#FFFFFF"
                                             Foreground="#0F172A"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"
                                             Padding="8,5"
                                             Placement="Mouse">
                                        <TextBlock Text="{Binding ContextTooltipText}"
                                                   FontSize="11"
                                                   Foreground="#0F172A" />
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Text="{Binding DisplayContextText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ContextForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Quotas List (5 hours, Weekly, etc.) -->
                    <ItemsControl ItemsSource="{Binding QuotaItems}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,5" ToolTip="{Binding TooltipText}">
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding WindowName}"
                                                   FontSize="11"
                                                   Foreground="#8A96AE"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RemainingPercentText}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar Value="{Binding RemainingPercent, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="4"
                                                 Foreground="{Binding ProgressBrush}"
                                                 Style="{StaticResource MiniProgressBarStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Border>

                <Border Background="Transparent"
                        HorizontalAlignment="Left"
                        Width="7"
                        Margin="0,8,0,8"
                        Cursor="SizeWE"
                        Tag="Left"
                        MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                        MouseMove="ResizeHandle_MouseMove"
                        MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"
                        LostMouseCapture="ResizeHandle_LostMouseCapture" />
                <Border Background="Transparent"
                        HorizontalAlignment="Right"
                        Width="7"
                        Margin="0,8,0,8"
                        Cursor="SizeWE"
                        Tag="Right"
                        MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                        MouseMove="ResizeHandle_MouseMove"
                        MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"
                        LostMouseCapture="ResizeHandle_LostMouseCapture" />
                <Border Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="10"
                        Height="10"
                        Cursor="SizeNWSE"
                        Tag="TopLeft"
                        MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                        MouseMove="ResizeHandle_MouseMove"
                        MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"
                        LostMouseCapture="ResizeHandle_LostMouseCapture" />
                <Border Background="Transparent"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="10"
                        Height="10"
                        Cursor="SizeNESW"
                        Tag="TopRight"
                        MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                        MouseMove="ResizeHandle_MouseMove"
                        MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"
                        LostMouseCapture="ResizeHandle_LostMouseCapture" />
                <Border Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Width="10"
                        Height="10"
                        Cursor="SizeNESW"
                        Tag="BottomLeft"
                        MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                        MouseMove="ResizeHandle_MouseMove"
                        MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"
                        LostMouseCapture="ResizeHandle_LostMouseCapture" />
                <Border Background="Transparent"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="10"
                        Height="10"
                        Cursor="SizeNWSE"
                        Tag="BottomRight"
                        MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"
                        MouseMove="ResizeHandle_MouseMove"
                        MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"
                        LostMouseCapture="ResizeHandle_LostMouseCapture" />
            </Grid>

            <!-- Right Buttons Panel (shown on right-click) -->
            <StackPanel x:Name="ControlButtonsPanel"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="7,0,0,0"
                        Visibility="{Binding ControlButtonsVisibility}">
                <!-- Green dot button: Restore normal mode -->
                <Button Margin="0,0,0,6"
                        ToolTip="기본 모드로 복귀"
                        Style="{StaticResource MiniRoundButtonStyle}"
                        Click="RestoreNormalMode_Click">
                    <Ellipse Width="8" Height="8" Fill="#38D66E" />
                </Button>

                <!-- Red power button: Exit application -->
                <Button ToolTip="완전 종료"
                        Style="{StaticResource MiniRoundButtonStyle}"
                        Click="ExitButton_Click">
                    <Path Width="10"
                          Height="10"
                          Stretch="Uniform"
                          Stroke="#FF5C5C"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 6,1.5 L 6,5.5 M 3.3,3.3 A 4.5,4.5 0 1 0 8.7,3.3" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
