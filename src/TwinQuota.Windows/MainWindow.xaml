<Window x:Class="TwinQuota.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TwinQuota"
        Width="410"
        Height="520"
        MinWidth="360"
        MinHeight="430"
        MaxWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="TQ" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="TwinQuota" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SurfaceText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        Width="36"
                        Height="34"
                        Padding="0"
                        Content="↻"
                        FontSize="18"
                        ToolTip="Refresh"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RefreshButton_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,14,18,18">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding LiveBadgeBackground}" CornerRadius="9" Padding="9,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding LiveBadgeForeground}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LiveStatusText}" Foreground="{Binding LiveBadgeForeground}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Active model" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,7" />
                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveModelName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ActiveModelId}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="8,3" Margin="10,1,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ActiveModelProvider}" Foreground="#C9C2FF" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="2,0,0,7">
                    <TextBlock Text="Quota windows" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding QuotaCountText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Quotas}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding WindowName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding RemainingText}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding ProgressBrush}" />
                                    </Grid>
                                    <ProgressBar Value="{Binding RemainingPercent}" Maximum="100" Margin="0,9,0,6" Foreground="{Binding ProgressBrush}" Style="{StaticResource QuotaProgressStyle}" />
                                    <TextBlock Text="{Binding ResetText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#101629" CornerRadius="10" Padding="11,8">
                    <TextBlock Text="{Binding Message}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               LineHeight="15"
                               MaxHeight="32"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
