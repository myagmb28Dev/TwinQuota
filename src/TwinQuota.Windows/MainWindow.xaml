<Window x:Class="TwinQuota.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TwinQuota"
        Width="680"
        Height="780"
        MinWidth="620"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="TQ" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TwinQuota" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Antigravity model quota monitor" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshButton_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,28">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding LiveBadgeBackground}" CornerRadius="10" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding LiveBadgeForeground}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding LiveStatusText}" Foreground="{Binding LiveBadgeForeground}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18" Padding="14">
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" />
                </Border>

                <TextBlock Text="Detected surfaces" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,10" />
                <ItemsControl ItemsSource="{Binding Products}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="13">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Quota windows" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,10" />
                <ItemsControl ItemsSource="{Binding Quotas}" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding WindowName}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RemainingText}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding ProgressBrush}" />
                                    </Grid>
                                    <ProgressBar Value="{Binding RemainingPercent}" Maximum="100" Margin="0,13,0,8" Foreground="{Binding ProgressBrush}" Style="{StaticResource QuotaProgressStyle}" />
                                    <TextBlock Text="{Binding ResetText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="2,0,0,10">
                    <TextBlock Text="Available agent models" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding ModelCountText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <ItemsControl ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="7,2" Margin="0,0,7,0">
                                                    <TextBlock Text="{Binding Provider}" Foreground="#C9C2FF" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding RemainingText}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{Binding RemainingBrush}" />
                                            <TextBlock Text="{Binding ResetText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
