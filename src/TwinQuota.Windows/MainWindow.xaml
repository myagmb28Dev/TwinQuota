<Window x:Class="TwinQuota.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TwinQuota"
        Icon="Assets/TwinQuota.ico"
        Width="240"
        Height="300"
        MinWidth="190"
        MinHeight="140"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource CardBrush}"
        Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="QuotaRowTemplate">
            <StackPanel Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WindowName}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RemainingText}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{Binding ProgressBrush}" />
                </Grid>
                <ProgressBar Value="{Binding RemainingPercent}"
                             Maximum="100"
                             Margin="0,5,0,5"
                             Foreground="{Binding ProgressBrush}"
                             Style="{StaticResource QuotaProgressStyle}" />
                <TextBlock Text="{Binding UsageText}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CompactQuotaRowTemplate">
            <StackPanel Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WindowName}" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RemainingText}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{Binding ProgressBrush}" />
                </Grid>
                <ProgressBar Value="{Binding RemainingPercent}"
                             Maximum="100"
                             Height="4"
                             Margin="0,4,0,4"
                             Foreground="{Binding ProgressBrush}"
                             Style="{StaticResource QuotaProgressStyle}" />
                <TextBlock Text="{Binding UsageText}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#521F00" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Foreground" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuitButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Background" Value="#242A3B" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QuitBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="QuitBorder" Property="Background" Value="#30384D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="QuitBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Margin" Value="0,2,2,2" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="7" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#99A7B1CC" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="#30384D"
                                    CornerRadius="10" />
                            <Ellipse x:Name="Knob"
                                     Width="14"
                                     Height="14"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="#F4F6FF" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#8B7CFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="Transparent">
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#101729"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="13,13,0,0">
                    <Grid Margin="17,0,9,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="Transparent"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                            <TextBlock Text="TwinQuota"
                                       Foreground="#C9C2FF"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button ToolTip="Minimize"
                                    Background="#FFBF3F"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Click="MinimizeButton_Click" />
                            <Button ToolTip="Maximize or restore"
                                    Background="#38D66E"
                                    Style="{StaticResource WindowControlButtonStyle}"
                                    Click="MaximizeButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Visibility="{Binding DashboardVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  Focusable="False"
                                  PanningMode="VerticalOnly"
                                  ScrollChanged="ScrollViewer_ScrollChanged">
                        <StackPanel Margin="17,10,17,10">
                            <TextBlock Text="{Binding ActiveModelName}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Quotas}"
                                          ItemTemplate="{StaticResource QuotaRowTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="1"
                            Content="Quit"
                            HorizontalAlignment="Right"
                            Margin="0,0,9,7"
                            Style="{StaticResource QuitButtonStyle}"
                            Click="QuitButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding ModelsVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="17,11,17,9">
                        <TextBlock Text="Models" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ModelCountText}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  Margin="9,0,9,9"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  Focusable="False"
                                  PanningMode="VerticalOnly"
                                  ScrollChanged="ScrollViewer_ScrollChanged">
                        <ItemsControl ItemsSource="{Binding AvailableModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,3">
                                        <Button Click="ModelRow_Click"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="#11172A"
                                                Foreground="{StaticResource TextBrush}"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="8"
                                                            Padding="10,8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#1B233A" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PrioritiesText}"
                                                           Foreground="#C9C2FF"
                                                           FontSize="10"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Border Visibility="{Binding DetailVisibility}"
                                                Margin="5,3,5,2"
                                                Padding="10,9,10,0"
                                                Background="#0C1120"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <ItemsControl ItemsSource="{Binding Quotas}"
                                                          ItemTemplate="{StaticResource CompactQuotaRowTemplate}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2"
                            Content="Quit"
                            HorizontalAlignment="Right"
                            Margin="0,0,9,7"
                            Style="{StaticResource QuitButtonStyle}"
                            Click="QuitButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding SettingsVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="17,10,17,10"
                               Text="Settings"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource OverlayScrollViewerStyle}"
                                  Focusable="False"
                                  PanningMode="VerticalOnly"
                                  ScrollChanged="ScrollViewer_ScrollChanged">
                        <Border Margin="10,0,10,10"
                                Padding="11"
                                Background="#11172A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Follow Antigravity windows"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Hide after focus moves outside TwinQuota or Antigravity."
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,7,0,0"
                                               Text="{Binding AntigravityWindowStatus}"
                                               Foreground="{Binding AntigravityWindowStatusBrush}"
                                               FontSize="10" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          VerticalAlignment="Top"
                                          IsChecked="{Binding ShowOnlyWhenAntigravityWindowIsOpen}"
                                          Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="9,0,9,7">
                        <Button Content="Save"
                                HorizontalAlignment="Left"
                                Background="#6F61E8"
                                IsEnabled="{Binding HasUnsavedSettings}"
                                Style="{StaticResource QuitButtonStyle}"
                                Click="SettingsSaveButton_Click" />
                        <Button Content="Quit"
                                HorizontalAlignment="Right"
                                Style="{StaticResource QuitButtonStyle}"
                                Click="QuitButton_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SidebarHoverZone"
                Width="12"
                Height="174"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,50,0,0"
                Background="Transparent"
                Panel.ZIndex="20"
                MouseEnter="SidebarHoverZone_MouseEnter"
                MouseLeave="SidebarHoverZone_MouseLeave" />

        <Popup x:Name="SidebarPopup"
               Placement="Relative"
               PlacementTarget="{Binding ElementName=RootSurface}"
               HorizontalOffset="-62"
               VerticalOffset="50"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border x:Name="SidebarPanel"
                    Width="62"
                    Padding="6"
                    DataContext="{Binding DataContext, ElementName=RootSurface}"
                    Background="#F20B1020"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MouseEnter="SidebarPanel_MouseEnter"
                    MouseLeave="SidebarPanel_MouseLeave">
                <StackPanel>
                    <Button Content="⌂"
                            ToolTip="Usage"
                            Background="{Binding HomeTabBackground}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="HomeTab_Click" />
                    <Button Content="☷"
                            ToolTip="Models"
                            Background="{Binding ModelsTabBackground}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="ModelsTab_Click" />
                    <Button Content="⚙"
                            ToolTip="Settings"
                            Background="{Binding SettingsTabBackground}"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SettingsTab_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="SidebarSensorPopup"
               Placement="Relative"
               PlacementTarget="{Binding ElementName=RootSurface}"
               HorizontalOffset="-62"
               VerticalOffset="50"
               AllowsTransparency="True"
               StaysOpen="True">
            <Border x:Name="SidebarSensor"
                    Width="74"
                    Height="174"
                    Background="#01000000"
                    MouseEnter="SidebarSensor_MouseEnter"
                    MouseLeave="SidebarSensor_MouseLeave" />
        </Popup>
    </Grid>
</Window>
